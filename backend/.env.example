PORT="3100"
CORS_ORIGIN="http://localhost:4300"
JWT_SECRET="reemplazar-con-un-secreto-largo-y-aleatorio"

# Supabase Storage privado para comprobantes. SERVICE_ROLE_KEY nunca va en el frontend.
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="reemplazar-con-service-role-key"
SUPABASE_STORAGE_BUCKET="comprobantes"

# Fallback exclusivamente local si Supabase Storage no está configurado.
STORAGE_PATH="./private-storage"

